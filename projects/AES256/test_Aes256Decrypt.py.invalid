# Corrected Python test script
import pytest
import os
import hashlib
from base64 import b64encode, b64decode
from Cryptodome.Cipher import AES
from projects.AES256.AES256 import decrypt  # Corrected the import statement to match the directory structure

# Test class name as given in the instructions
class Test_Aes256Decrypt:

    @pytest.mark.valid
    def test_valid_decryption_with_correct_password(self):
        # Arrange
        password = "securepassword123"
        plaintext = "This is a secret message"
        salt = b64encode(os.urandom(16)).decode('utf-8')
        private_key = hashlib.scrypt(
            password.encode(), salt=b64decode(salt), n=2**14, r=8, p=1, dklen=32
        )
        cipher = AES.new(private_key, AES.MODE_GCM)
        cipher_text, tag = cipher.encrypt_and_digest(plaintext.encode())
        enc_dict = {
            "salt": salt,
            "cipher_text": b64encode(cipher_text).decode('utf-8'),
            "nonce": b64encode(cipher.nonce).decode('utf-8'),
            "tag": b64encode(tag).decode('utf-8')
        }
        
        # Act
        decrypted_text = decrypt(enc_dict, password)
        
        # Assert
        assert decrypted_text == plaintext

    @pytest.mark.invalid
    def test_decryption_with_incorrect_password(self):
        # Arrange
        correct_password = "securepassword123"
        incorrect_password = "wrongpassword456"
        plaintext = "This is a secret message"
        salt = b64encode(os.urandom(16)).decode('utf-8')
        private_key = hashlib.scrypt(
            correct_password.encode(), salt=b64decode(salt), n=2**14, r=8, p=1, dklen=32
        )
        cipher = AES.new(private_key, AES.MODE_GCM)
        cipher_text, tag = cipher.encrypt_and_digest(plaintext.encode())
        enc_dict = {
            "salt": salt,
            "cipher_text": b64encode(cipher_text).decode('utf-8'),
            "nonce": b64encode(cipher.nonce).decode('utf-8'),
            "tag": b64encode(tag).decode('utf-8')
        }

        # Act and Assert
        with pytest.raises(ValueError, match="Invalid encrypted message format."):
            decrypt(enc_dict, incorrect_password)

    @pytest.mark.negative
    def test_decryption_with_empty_password(self):
        # Arrange
        enc_dict = {
            "salt": b64encode(os.urandom(16)).decode('utf-8'),
            "cipher_text": b64encode(b"This is fake cipher text!").decode('utf-8'),
            "nonce": b64encode(os.urandom(12)).decode('utf-8'),
            "tag": b64encode(os.urandom(16)).decode('utf-8')
        }
        password = ""  # Empty password
        
        # Act and Assert
        with pytest.raises(ValueError, match="Password cannot be empty."):
            decrypt(enc_dict, password)

    @pytest.mark.invalid
    def test_decryption_with_invalid_encrypted_message_format(self):
        # Arrange
        enc_dict = {
            "salt": "invalid_base64",
            "cipher_text": "invalid_base64",
            "nonce": "invalid_base64",
            "tag": "invalid_base64"
        }
        password = "somepassword123"
        
        # Act and Assert
        with pytest.raises(ValueError, match="Invalid encrypted message format."):
            decrypt(enc_dict, password)

    @pytest.mark.regression
    def test_decryption_with_missing_fields_in_enc_dict(self):
        # Arrange
        enc_dict = {
            # Missing required keys like 'salt', 'nonce', 'tag', etc.
            "cipher_text": b64encode(b"This is fake cipher text!").decode('utf-8')
        }
        password = "securepassword123"
        
        # Act and Assert
        with pytest.raises(ValueError, match="Invalid encrypted message format."):
            decrypt(enc_dict, password)
